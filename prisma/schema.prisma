generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

model AnggaranTKD {
  id          Int      @id @default(autoincrement())
  jenis_tkd   String
  tahun       Int
  daerah      String
  semula      BigInt?
  pencadangan BigInt?
  menjadi     BigInt?
  pagu        BigInt?
  realisasi   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlokasiTKD {
  id           Int      @id @default(autoincrement())
  tahun        Int
  daerah       String
  dbh          Decimal
  dau          Decimal
  dakFisik     Decimal
  dakNonfisik  Decimal
  danaDesa     Decimal
  infis        Decimal
  total        Decimal
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id        Int    @id @default(autoincrement())
  email     String @unique
  kode      String
}


